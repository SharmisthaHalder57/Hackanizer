# ──────────────────────────────────────────────
# HackAnizer Backend — Environment Variables
# ──────────────────────────────────────────────

# JWT Secret Key — change this in production!
JWT_SECRET_KEY=hackanizer-super-secret-jwt-key-change-me

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Token expiry in minutes (24 hours)
JWT_EXPIRE_MINUTES=1440

# Path to Firebase service account JSON
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json

# Firebase Project ID (used for manual token verification)
FIREBASE_PROJECT_ID=hackanizer-680bd

# FastAPI server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Flask gateway server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
